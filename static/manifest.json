{
  "manifest_version": 3,
  "name": "Brace",
  "version": "0.1.0",
  "description": "Readable, collapsible JSON in the browser, plus a paste-and-format tool. Lossless numbers, local only.",
  "homepage_url": "https://github.com/natgurlain/brace",
  "permissions": [
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Format JSON",
    "default_icon": {
      "16": "icons/on-16.png",
      "32": "icons/on-32.png",
      "48": "icons/on-48.png"
    }
  },
  "icons": {
    "16": "icons/on-16.png",
    "32": "icons/on-32.png",
    "48": "icons/on-48.png",
    "128": "icons/on-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "detect.js"
      ],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/on-48.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
